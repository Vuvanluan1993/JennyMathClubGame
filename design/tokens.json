    "[data-theme-family=lms]": {
      "description": "Họ Classroom (GV/PH/QL): chỉ đổi họ chữ và bo góc",
      "set": {"--jc-font-display": "{font.lms}", "--jc-font-body": "{font.lms}", "--jc-radius": "{radius.lms}"}
    }
