rules_version = '2';
// Quy tắc bảo mật Firestore — Lớp học ảo Jenny (nhiều trường, 09/11/2026)
// he/main        : {admins: [uid]} — admin Clb (quản trị hệ thống), tạo một lần ở "Thiết lập lần đầu"
// truong/{mã}    : dữ liệu một trường (j = JSON), gd = {tk: lớp}, pc = {gvId: [lớp]}, ten, ma, khoa (true = khoá)
// users/{uid}    : role (qt | ql | gv | hs | ph), tk (tên đăng nhập, dạng mã.tên), truong (mã trường), gvId, con
// hs/{tk}        : dữ liệu học của em (em tự ghi) · hsgv/{tk}: nhận xét, thẻ, ghi chú của cô — đều có trường "truong"
// asg/{id}       : bài về nhà (có "truong") · login/{tk}: tên đăng nhập → email (đặt lại mật khẩu)
// tom/{tk}       : tóm tắt học tập của em (có "truong"), em tự ghi, admin Clb/quản lý/giáo viên đọc
// org/main       : dữ liệu cũ trước khi có nhiều trường — chỉ admin Clb đọc để chuyển sang truong/jenny
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function hasMe() { return signed() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isQT() { return hasMe() && me().role == 'qt'; }
    function isQL() { return hasMe() && me().role == 'ql'; }
    function isGV() { return hasMe() && me().role == 'gv'; }
    function myT() { return me().truong; }
    function tdoc() { return get(/databases/$(db)/documents/truong/$(me().truong)).data; }
    function isSelf(tk) { return hasMe() && me().role == 'hs' && me().tk == tk; }
    function isPH(tk) { return hasMe() && me().role == 'ph' && tk in me().con; }
    function gvLop(tk) {
      return isGV() && (tk in tdoc().gd) && (me().gvId in tdoc().pc) && (tdoc().gd[tk] in tdoc().pc[me().gvId]);
    }
    // ghi vào tài liệu của trường mình (dữ liệu mới và cũ đều thuộc trường mình)
    function vaoT() { return request.resource.data.truong == myT(); }
    function cuT() { return resource == null || resource.data.truong == myT(); }

    match /he/main {
      allow read: if signed();
      allow create: if signed() && request.resource.data.admins == [request.auth.uid];
      allow update: if isQT();
    }
    match /org/main {
      allow read, write: if isQT();
    }
    match /truong/{ma} {
      allow read: if isQT() || (hasMe() && myT() == ma);
      allow create, delete: if isQT();
      allow update: if isQT()
        || (isQL() && myT() == ma && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ma', 'ten', 'khoa']))
        || (isGV() && myT() == ma && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['j', 't', 'gd']));
    }
    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isQT() || ((isQL() || isGV()) && resource.data.truong == myT()));
      allow create: if isQT()
        || (isQL() && vaoT() && request.resource.data.role in ['gv', 'hs', 'ph'])
        || (isGV() && vaoT() && request.resource.data.role in ['hs', 'ph'])
        || (signed() && request.auth.uid == uid && request.resource.data.role == 'qt'
            && request.auth.uid in get(/databases/$(db)/documents/he/main).data.admins);
      allow update: if isQT()
        || (isQL() && resource.data.truong == myT() && vaoT() && resource.data.role != 'qt'
            && (request.resource.data.role == resource.data.role || request.resource.data.role in ['gv', 'hs', 'ph']))
        || (isGV() && resource.data.truong == myT() && vaoT() && resource.data.role == 'ph' && request.resource.data.role == 'ph');
      allow delete: if isQT() || (isQL() && resource.data.truong == myT() && resource.data.role != 'qt');
    }
    match /hs/{tk} {
      allow read: if isSelf(tk) || isQT() || (isQL() && cuT()) || gvLop(tk) || isPH(tk) || (isGV() && resource == null);
      allow create: if isQT() || (isSelf(tk) && vaoT()) || ((isQL() || isGV()) && vaoT());
      allow update: if isQT() || (isSelf(tk) && vaoT()) || (isQL() && cuT() && vaoT());
      allow delete: if isQT() || (isQL() && cuT());
    }
    match /hsgv/{tk} {
      allow read: if isSelf(tk) || isQT() || (isQL() && cuT()) || gvLop(tk) || isPH(tk) || (isGV() && resource == null);
      allow create, update: if isQT() || ((isQL() || gvLop(tk)) && cuT() && vaoT());
      allow delete: if isQT() || (isQL() && cuT());
    }
    match /login/{tk} {
      allow read: if true;
      allow create, update: if isQT() || (isQL() && cuT() && vaoT());
      allow delete: if isQT() || (isQL() && cuT());
    }
    match /tom/{tk} {
      // tóm tắt học tập của em (lần học cuối, số câu, tỉ lệ đúng, sao, Sức mạnh Toán) — để admin Clb, quản lý xem nhanh
      allow read: if isQT() || ((isQL() || isGV()) && cuT());
      allow create, update: if isQT() || (isSelf(tk) && vaoT()) || (isQL() && cuT() && vaoT());
      allow delete: if isQT() || (isQL() && cuT());
    }
    match /asg/{id} {
      allow read: if isQT() || (hasMe() && resource.data.truong == myT());
      allow create, update: if isQT() || ((isQL() || isGV()) && cuT() && vaoT());
      allow delete: if isQT() || ((isQL() || isGV()) && cuT());
    }
  }
}
